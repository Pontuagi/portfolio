rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminPath())
        && get(adminPath()).data.role in ["owner", "admin"];
    }

    function validBlogStatus(status) {
      return status in ["pending", "approved", "rejected"];
    }

    function validBlogPostCreate() {
      return request.resource.data.keys().hasAll([
          "title",
          "content",
          "preview",
          "wordCount",
          "authorId",
          "authorName",
          "authorEmail",
          "status",
          "createdAt",
          "updatedAt",
          "publishedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "title",
          "content",
          "preview",
          "wordCount",
          "authorId",
          "authorName",
          "authorEmail",
          "status",
          "createdAt",
          "updatedAt",
          "publishedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.preview is string
        && request.resource.data.wordCount is int
        && request.resource.data.wordCount > 0
        && request.resource.data.wordCount <= 500
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.publishedAt == null;
    }

    function ownPendingPostEdit() {
      return signedIn()
        && resource.data.authorId == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorEmail == resource.data.authorEmail
        && request.resource.data.status == "pending"
        && request.resource.data.publishedAt == resource.data.publishedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title",
          "content",
          "preview",
          "wordCount",
          "updatedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.preview is string
        && request.resource.data.wordCount is int
        && request.resource.data.wordCount > 0
        && request.resource.data.wordCount <= 500
        && request.resource.data.updatedAt is timestamp;
    }

    function adminModerationUpdate() {
      return isAdmin()
        && validBlogStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "publishedAt",
          "updatedAt"
        ])
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.status == "approved"
            && request.resource.data.publishedAt is timestamp
          )
          || (
            request.resource.data.status == "rejected"
            && request.resource.data.publishedAt == resource.data.publishedAt
          )
        );
    }

    match /admins/{userId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.status == "approved"
        || (signedIn() && resource.data.authorId == request.auth.uid)
        || isAdmin();

      allow create: if signedIn() && validBlogPostCreate();

      allow update: if ownPendingPostEdit() || adminModerationUpdate();

      allow delete: if isAdmin();
    }
  }
}
